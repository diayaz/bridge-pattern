digraph UML {
 rankdir=TB; nodesep=0.6; ranksep=0.8;
 node [shape=plaintext, fontname="Helvetica", fontsize=11];
 edge [fontname="Helvetica", fontsize=10];
Main [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8EEF7"><B>Main (Client)</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">+ main(args: String[]): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Shape [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8EEF7">&laquo;abstract&raquo;<BR/><B>Shape (Abstraction)</B></TD></TR><TR><TD ALIGN="LEFT"># renderer: Renderer<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT"># Shape(renderer: Renderer)<BR ALIGN='LEFT'/>+ setRenderer(renderer: Renderer): void<BR ALIGN='LEFT'/>+ draw(): void  {abstract}<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Circle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8EEF7"><B>Circle (Refined Abstraction)</B></TD></TR><TR><TD ALIGN="LEFT">- radius: double<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+ Circle(radius: double, renderer: Renderer)<BR ALIGN='LEFT'/>+ draw(): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Square [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8EEF7"><B>Square (Refined Abstraction)</B></TD></TR><TR><TD ALIGN="LEFT">- side: double<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+ Square(side: double, renderer: Renderer)<BR ALIGN='LEFT'/>+ draw(): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Renderer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8EEF7">&laquo;interface&raquo;<BR/><B>Renderer (Implementor)</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">+ renderCircle(radius: double): void<BR ALIGN='LEFT'/>+ renderSquare(side: double): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Vector [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8EEF7"><B>VectorRenderer (Concrete Implementor)</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">+ renderCircle(radius: double): void<BR ALIGN='LEFT'/>+ renderSquare(side: double): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Raster [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8EEF7"><B>RasterRenderer (Concrete Implementor)</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">+ renderCircle(radius: double): void<BR ALIGN='LEFT'/>+ renderSquare(side: double): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
 {rank=same; Shape; Renderer;}
 Main -> Shape [style=dashed, arrowhead=vee, label=" uses"];
 Main -> Renderer [style=dashed, arrowhead=vee, label=" creates"];
 Shape -> Renderer [dir=both, arrowtail=odiamond, arrowhead=vee, penwidth=2, label="  bridge (composition)  ", fontsize=12, fontcolor="#1F4E9E", color="#1F4E9E"];
 Shape -> Circle [dir=back, arrowtail=onormal];
 Shape -> Square [dir=back, arrowtail=onormal];
 Renderer -> Vector [dir=back, arrowtail=onormal, style=dashed];
 Renderer -> Raster [dir=back, arrowtail=onormal, style=dashed];
}